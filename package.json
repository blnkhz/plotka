{
  "name": "plotter-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Desktop app for preparing SVG artwork and plotting it on EBB pen plotters (AxiDraw, NextDraw).",
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @plotter-studio/desktop dev",
    "build": "pnpm --filter @plotter-studio/desktop build",
    "build:mac": "pnpm --filter @plotter-studio/desktop build:mac",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "pnpm --filter @plotter-studio/desktop test:e2e",
    "spike": "pnpm --filter @plotter-studio/driver-spike spike"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
