{
  "name": "@plotka/desktop",
  "productName": "Plotka",
  "version": "0.6.0",
  "private": true,
  "license": "MIT",
  "description": "Plotka desktop app",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:mac": "electron-vite build && electron-builder --mac --universal --publish never",
    "build:win": "electron-vite build && electron-builder --win --x64 --publish never",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.e2e.json",
    "test:e2e": "electron-vite build && playwright test"
  },
  "dependencies": {
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/dm-mono": "5.3.0",
    "@playwright/test": "^1.64.1",
    "@plotka/core": "workspace:*",
    "@plotka/plotter": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "marked": "^18.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.186.1",
    "vite": "^8.3.5",
    "zustand": "^5.0.16"
  }
}
